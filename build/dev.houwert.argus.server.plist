<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd *agent* for Argus Server. Installed to ~/Library/LaunchAgents by
  scripts/install-server-agent.sh.

  It must be an agent, not a daemon: CoreSimulator needs a logged-in Aqua
  session, and `simctl boot` fails outright under a system daemon. The Mac mini
  therefore has to auto-login to the user this agent belongs to.

  @APP@ is substituted by the install script.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>dev.houwert.argus.server</string>
    <key>ProgramArguments</key>
    <array>
      <string>@APP@/Contents/MacOS/Argus Server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>@HOME@/.argus-server/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/.argus-server/launchd.err.log</string>
  </dict>
</plist>
