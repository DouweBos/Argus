<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  argus-sim-input runs inside a simulator through `simctl spawn`, which finds
  the simulator's dyld via DYLD_ROOT_PATH. The hardened runtime strips DYLD_*
  variables unless this is set, and the helper aborts at launch.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
