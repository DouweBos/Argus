{
  "setup": {
    "copy": [
      ".claude",
      "node_modules",
      "native/conductor",
      "native/scrcpy-server",
      "native/argus-sim-bridge/argus-sim-bridge"
    ],
    "commands": ["mise trust mise.toml"]
  },
  "run": [
    {
      "title": "Dev",
      "command": "ARGUS_HOME=\"$HOME/.argus-dev-${ARGUS_PORT:-1420}\" ARGUS_REMOTE_PORT=$((47616 + 2 * (${ARGUS_PORT:-1420} - 1420))) pnpm dev",
      "restartOnRerun": true
    },
    {
      "title": "Mac app",
      "command": "xcodebuild -project clients/apple/ArgusRemote.xcodeproj -scheme ArgusDesktop -destination 'platform=macOS,arch=arm64' -derivedDataPath .build/mac-dd build -quiet && ARGUS_HOME=\"$HOME/.argus-mac-dev-${ARGUS_PORT:-1420}\" ARGUS_REMOTE_PORT=$((48016 + ${ARGUS_PORT:-1420} - 1420)) \".build/mac-dd/Build/Products/Debug/Argus.app/Contents/MacOS/Argus\"",
      "restartOnRerun": true
    },
    {
      "title": "Dev: Server",
      "command": "ARGUS_HOME=\"$HOME/.argus-server-dev-${ARGUS_PORT:-1420}\" ARGUS_REMOTE_PORT=$((47617 + 2 * (${ARGUS_PORT:-1420} - 1420))) pnpm dev:server",
      "restartOnRerun": true
    },
    {
      "title": "Storybook",
      "command": "pnpm storybook",
      "restartOnRerun": true
    }
  ],
  "single_runtime": true,
  "workspace_env": [
    {
      "name": "ARGUS_PORT",
      "base_value": 1420,
      "range": 100,
      "strategy": "sequential"
    }
  ],
  "release_note_patterns": [
    {
      "glob": ".changeset/*.md",
      "format": "changesets",
      "labels": []
    }
  ]
}
