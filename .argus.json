{
  "setup": {
    "copy": [
      ".claude",
      "node_modules",
      "native/conductor",
      "native/scrcpy-server",
      "native/argus-sim-bridge/argus-sim-bridge"
    ],
    "commands": ["mise trust mise.toml"]
  },
  "run": [
    {
      "title": "Dev",
      "command": "ARGUS_HOME=\"$HOME/.argus-dev-$ARGUS_PORT\" pnpm dev",
      "restartOnRerun": true
    },
    {
      "title": "Storybook",
      "command": "pnpm storybook",
      "restartOnRerun": true
    },
    {
      "title": "Remote: Install iOS",
      "command": "npm install --silent && npx expo run:ios --configuration Release --no-bundler --device \"${ARGUS_IOS_DEVICE:-00008120-001979643C9B401E}\"",
      "cwd": "clients/argus-remote",
      "restartOnRerun": true
    },
    {
      "title": "Remote: Install Android",
      "command": "npm install --silent && npx expo run:android --variant release --no-bundler",
      "cwd": "clients/argus-remote",
      "restartOnRerun": true
    },
    {
      "title": "Remote: Metro",
      "command": "npm install --silent && npx expo start --dev-client",
      "cwd": "clients/argus-remote",
      "restartOnRerun": true
    }
  ],
  "single_runtime": true,
  "workspace_env": [
    {
      "name": "ARGUS_PORT",
      "base_value": 1420,
      "range": 100,
      "strategy": "sequential"
    }
  ],
  "release_note_patterns": [
    {
      "glob": ".changeset/*.md",
      "format": "changesets",
      "labels": []
    }
  ]
}
