{
  "setup": {
    "copy": [
      ".claude",
      "node_modules",
      "native/conductor",
      "native/scrcpy-server",
      "native/argus-sim-bridge/argus-sim-bridge"
    ]
  },
  "run": [
    {
      "title": "Dev",
      "command": "pnpm dev",
      "restartOnRerun": true
    },
    {
      "title": "Storybook",
      "command": "pnpm storybook",
      "restartOnRerun": true
    }
  ],
  "single_runtime": true,
  "workspace_env": [
    {
      "name": "ARGUS_PORT",
      "base_value": 1420,
      "range": 100,
      "strategy": "sequential"
    }
  ],
  "release_note_patterns": [
    {
      "glob": ".changeset/*.md",
      "format": "changesets",
      "labels": []
    }
  ]
}
