{
  "setup": {
    "copy": [
      ".claude",
      "native/conductor",
      "native/scrcpy-server",
      "native/argus-sim-bridge/argus-sim-bridge"
    ],
    "commands": [
      "mise trust mise.toml",
      "mise exec -- pnpm install --frozen-lockfile"
    ]
  },
  "run": [
    {
      "title": "Mac app",
      "command": "xcodebuild -project clients/apple/ArgusRemote.xcodeproj -scheme ArgusDesktop -destination 'platform=macOS,arch=arm64' -derivedDataPath .build/mac-dd build -quiet && ARGUS_HOME=\"$HOME/.argus-mac-dev-${ARGUS_PORT:-1420}\" ARGUS_REMOTE_PORT=$((48016 + ${ARGUS_PORT:-1420} - 1420)) \".build/mac-dd/Build/Products/Debug/Argus.app/Contents/MacOS/Argus\"",
      "restartOnRerun": true
    },
    {
      "title": "Mac server",
      "command": "xcodebuild -project clients/apple/ArgusRemote.xcodeproj -scheme ArgusServer -destination 'platform=macOS,arch=arm64' -derivedDataPath .build/mac-server-dd build -quiet && ARGUS_HOME=\"$HOME/.argus-mac-server-dev-${ARGUS_PORT:-1420}\" ARGUS_REMOTE_PORT=$((48116 + ${ARGUS_PORT:-1420} - 1420)) \".build/mac-server-dd/Build/Products/Debug/Argus Server.app/Contents/MacOS/Argus Server\"",
      "restartOnRerun": true
    },
    {
      "title": "Storybook",
      "command": "pnpm storybook",
      "restartOnRerun": true
    }
  ],
  "single_runtime": true,
  "workspace_env": [
    {
      "name": "ARGUS_PORT",
      "base_value": 1420,
      "range": 100,
      "strategy": "sequential"
    }
  ],
  "release_note_patterns": [
    {
      "glob": ".changeset/*.md",
      "format": "changesets",
      "labels": []
    }
  ]
}
