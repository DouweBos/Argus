{
  "setup": {
    "copy": [
      ".claude",
      "node_modules"
    ]
  },
  "terminals": [
    {
      "name": "Shell",
      "dir": "."
    }
  ],
  "run": [
    {
      "title": "Dev",
      "command": "pnpm dev",
      "restartOnRerun": true
    }
  ],
  "workspace_env": [
    {
      "name": "ARGUS_PORT",
      "base_value": 1420,
      "range": 100,
      "strategy": "sequential"
    }
  ],
  "protected_branches": ["main"]
}