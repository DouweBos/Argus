# Shared cert storage across all of Douwe's projects. The repo holds
# every type (development, distribution, developer_id, …) encrypted
# with MATCH_PASSWORD. For Argus we only read `developer_id`.
#
# First time on a machine:
#   export MATCH_PASSWORD="<the shared password>"
#   pnpm certs
#
# By default match only syncs the `developer_id` cert + private key. Argus for
# Mac also has a provisioning profile (Sign in with Apple):
# `fastlane mac mac_app_profile`.

git_url ENV["MATCH_GIT_URL"] || "git@github.com:DouweBos/apple-certificates.git"
storage_mode "git"
type "developer_id"
platform "macos"

# Argus Server has no profile-bound entitlements, so don't let match fetch a
# "Direct" profile by default. The `mac_app_profile` lane overrides this.
skip_provisioning_profiles true
