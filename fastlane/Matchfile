# Shared cert storage across all of Douwe's projects. The repo holds
# every type (development, distribution, developer_id, …) encrypted
# with MATCH_PASSWORD. For Argus we only read `developer_id`.
#
# First time on a machine:
#   export MATCH_PASSWORD="<the shared password>"
#   pnpm certs
#
# `developer_id` on macOS has no provisioning profile — match only
# syncs the cert + private key.

git_url ENV["MATCH_GIT_URL"] || "git@github.com:DouweBos/apple-certificates.git"
storage_mode "git"
type "developer_id"
platform "macos"

# Argus has no profile-bound entitlements (push, iCloud, etc.), so don't
# let match try to fetch a "Direct" provisioning profile from the dev
# portal — it fails and isn't needed for Developer ID distribution.
skip_provisioning_profiles true
