require "digest"
require "time"
require "yaml"

default_platform(:mac)

TEAM_ID      = "CKZT75PN5T"
# The Electron app's bundle id: Squirrel.Mac only swaps in a bundle that
# satisfies the running app's designated requirement, so Argus for Mac takes it over.
MAC_APP_BUNDLE_ID = "dev.houwert.argus"
SIGN_IDENTITY_RELEASE = "Douwe Bos (#{TEAM_ID})"

# Commit-count builds reached 1837; the offset keeps run-number builds above them.
BUILD_NUMBER_OFFSET = 2000

# Sparkle and TestFlight order builds by CFBundleVersion: the workflow's run number keeps it growing.
def ci_build_number
  run = ENV["GITHUB_RUN_NUMBER"].to_s
  UI.user_error!("GITHUB_RUN_NUMBER is not set: release builds come from the GitHub workflow") if run.empty?
  (run.to_i + BUILD_NUMBER_OFFSET).to_s
end

platform :mac do
  desc "Sync the Developer ID Application cert from the match repo. Pass generate:true on first run to create and upload a new cert."
  lane :certs do |options|
    # In CI we always authenticate via API key (non-interactive).
    # Locally, fall back to interactive Apple ID + 2FA when the API
    # key env vars are not set — saves the "set up a key just to try
    # it once" friction.
    api_key = ENV["APP_STORE_CONNECT_API_KEY_ID"] ? load_app_store_connect_api_key : nil
    UI.user_error!("CI must authenticate via APP_STORE_CONNECT_API_KEY_* env vars") if is_ci && api_key.nil?

    match_options = {
      type:                       "developer_id",
      readonly:                   !options.fetch(:generate, false),
      platform:                   "macos",
      # Only the cert: Argus for Mac's profile comes from mac_app_profile, and
      # Argus Server needs none.
      skip_provisioning_profiles: true,
    }
    match_options[:api_key] = api_key if api_key

    match(**match_options)
  end

  desc "Sync the Developer ID profile for Argus for Mac (dev.houwert.argus), which Sign in with Apple needs. Pass generate:true once to create and upload it."
  lane :mac_app_profile do |options|
    api_key = ENV["APP_STORE_CONNECT_API_KEY_ID"] ? load_app_store_connect_api_key : nil
    UI.user_error!("CI must authenticate via APP_STORE_CONNECT_API_KEY_* env vars") if is_ci && api_key.nil?

    # Installs as "match Direct dev.houwert.argus macos", the name the
    # ArgusDesktop Release config pins.
    match_options = {
      type:                       "developer_id",
      readonly:                   !options.fetch(:generate, false),
      platform:                   "macos",
      app_identifier:             MAC_APP_BUNDLE_ID,
      skip_provisioning_profiles: false,
    }
    match_options[:api_key] = api_key if api_key

    match(**match_options)
  end

  desc "Argus Server (native, clients/apple/ArgusServer): archive, Developer ID export, notarize, staple, zip, Sparkle appcast, GitHub release upload. Pass channel:beta|alpha for pre-releases, publish:false to stop before uploading. Needs SPARKLE_PUBLIC_ED_KEY and SPARKLE_ED_PRIVATE_KEY."
  lane :mac_server_release do |options|
    release_native_app(
      options,
      scheme:       "ArgusServer",
      app_name:     "Argus Server",
      zip_prefix:   "Argus-Server",
      product:      "argus-server",
      out_dir:      "release-mac-server",
    )
  end

  desc "Argus for Mac (native, clients/apple/ArgusDesktop): as mac_server_release, plus a .dmg and, on production, cutover-mac.yml, the feed still-installed Electron apps update into it from. Needs the profile from mac_app_profile."
  lane :mac_app_release do |options|
    release_native_app(
      options,
      scheme:       "ArgusDesktop",
      app_name:     "Argus",
      zip_prefix:   "Argus-Mac",
      product:      "argus-mac",
      out_dir:      "release-mac-app",
      bundle_id:    MAC_APP_BUNDLE_ID,
      dmg_name:     "Argus",
      electron_cutover: true,
    )
  end

  # ---------------------------------------------------------------
  # Helpers
  # ---------------------------------------------------------------

  # Archive, export, notarize and publish a native app with its Sparkle
  # appcast. `bundle_id` is set for an app with profile-bound entitlements.
  def release_native_app(options, scheme:, app_name:, zip_prefix:, product:, out_dir:, bundle_id: nil, dmg_name: nil, electron_cutover: false)
    publish = options.fetch(:publish, true)
    channel = options.fetch(:channel, "production")
    unless ["production", "beta", "alpha"].include?(channel)
      UI.user_error!("Unknown channel #{channel.inspect} — expected production | beta | alpha")
    end
    feed_channel = channel == "production" ? "latest" : channel

    ensure_git_status_clean unless options[:allow_dirty]
    if channel == "production" || channel == "beta"
      ensure_git_branch(branch: "main") unless options[:allow_any_branch]
    end

    public_key  = ENV["SPARKLE_PUBLIC_ED_KEY"]
    private_key = ENV["SPARKLE_ED_PRIVATE_KEY"]
    # A build without a key can never verify an update, so it would never take one.
    UI.user_error!("Missing SPARKLE_PUBLIC_ED_KEY") if public_key.nil? || public_key.empty?
    UI.user_error!("Missing SPARKLE_ED_PRIVATE_KEY") if private_key.nil? || private_key.empty?

    api_key = load_app_store_connect_api_key
    match_options = {
      type:                       "developer_id",
      readonly:                   true,
      api_key:                    api_key,
      platform:                   "macos",
      skip_provisioning_profiles: bundle_id.nil?,
    }
    match_options[:app_identifier] = bundle_id if bundle_id
    match(**match_options)

    version = read_package_version
    build_number = ci_build_number
    UI.success("Releasing #{app_name} v#{version} (#{build_number}) on #{feed_channel}")

    root = File.expand_path("..", __dir__)
    out = File.join(root, out_dir)
    FileUtils.rm_rf(out)
    FileUtils.mkdir_p(out)
    archive = File.join(out, "#{scheme}.xcarchive")
    derived = File.join(out, "dd")
    # CI clones packages into a cached folder outside `out`, which is wiped each run.
    packages = ENV["SPM_CLONE_DIR"].to_s.empty? ? File.join(derived, "SourcePackages") : ENV["SPM_CLONE_DIR"]

    sh("cd #{root.shellescape} && pnpm install --frozen-lockfile && pnpm build:web-client")
    sh([
      "xcodebuild", "archive",
      "-project", File.join(root, "clients/apple/ArgusRemote.xcodeproj"),
      "-scheme", scheme,
      "-configuration", "Release",
      "-destination", "generic/platform=macOS",
      "-archivePath", archive,
      "-derivedDataPath", derived,
      "-clonedSourcePackagesDirPath", packages,
      # System git, so the url.insteadOf CI sets reaches private packages (Grove).
      "-scmProvider", "system",
      "MARKETING_VERSION=#{version}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "SPARKLE_PUBLIC_ED_KEY=#{public_key}",
    ].shelljoin)

    profiles = bundle_id ? <<~XML : ""
      <key>provisioningProfiles</key>
      <dict><key>#{bundle_id}</key><string>match Direct #{bundle_id} macos</string></dict>
    XML
    export_options = File.join(out, "ExportOptions.plist")
    File.write(export_options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>developer-id</string>
        <key>teamID</key><string>#{TEAM_ID}</string>
        <key>signingStyle</key><string>manual</string>
        <key>signingCertificate</key><string>Developer ID Application</string>
        #{profiles}
      </dict>
      </plist>
    PLIST
    sh(["xcodebuild", "-exportArchive", "-archivePath", archive, "-exportOptionsPlist", export_options, "-exportPath", out].shelljoin)

    app = File.join(out, "#{app_name}.app")
    zip_name = "#{zip_prefix}-#{version}-arm64.zip"
    zip = File.join(out, zip_name)

    # Notarize the zip, staple the app, then zip the stapled app for shipping.
    prepare_notarize_env
    sh(["ditto", "-c", "-k", "--keepParent", app, zip].shelljoin)
    sh([
      "xcrun", "notarytool", "submit", zip, "--wait",
      "--key", ENV["APPLE_API_KEY"], "--key-id", ENV["APPLE_API_KEY_ID"], "--issuer", ENV["APPLE_API_ISSUER"],
    ].shelljoin)
    sh(["xcrun", "stapler", "staple", app].shelljoin)
    sh(["spctl", "-a", "-vv", app].shelljoin)
    FileUtils.rm_f(zip)
    sh(["ditto", "-c", "-k", "--keepParent", app, zip].shelljoin)

    # One appcast per channel, kept next to the release assets; the current one
    # is fetched first so older builds stay listed. A release also lands in every
    # less stable channel's feed, so beta and alpha installs get production builds.
    feeds = File.join(out, "feeds")
    FileUtils.mkdir_p(feeds)
    FileUtils.cp(zip, feeds)
    channels = %w[latest beta alpha]
    appcasts = channels.drop(channels.index(feed_channel)).map do |c|
      name = "#{product}-#{c}.xml"
      path = File.join(out, "appcasts", name)
      FileUtils.mkdir_p(File.dirname(path))
      sh("curl -fsSL https://houwert.dev/argus/updates/#{name} -o #{path.shellescape} || rm -f #{path.shellescape}")
      path
    end
    # Sparkle's update window shows these; the lane's own CHANGELOG section, embedded.
    notes_html = File.join(feeds, "#{File.basename(zip, ".zip")}.html")
    sh("cd .. && pnpm exec tsx scripts/release-notes-html.ts #{release_notes_file.shellescape} #{notes_html.shellescape}")
    key_file = File.join(out, "sparkle-ed.key")
    File.write(key_file, private_key)
    at_exit { File.delete(key_file) if File.exist?(key_file) }
    generate_appcast = File.join(packages, "artifacts/sparkle/Sparkle/bin/generate_appcast")
    appcasts.each do |appcast|
      sh([
        generate_appcast, "--ed-key-file", key_file,
        "--download-url-prefix", "https://houwert.dev/argus/updates/",
        "--embed-release-notes",
        "-o", appcast, feeds,
      ].shelljoin)
    end
    assets = [zip, *appcasts]

    # Named like the Electron app's was, so the website's `Argus-latest-arm64.dmg` link keeps resolving.
    if dmg_name
      stage = File.join(out, "dmg")
      FileUtils.mkdir_p(stage)
      sh(["ditto", app, File.join(stage, File.basename(app))].shelljoin)
      File.symlink("/Applications", File.join(stage, "Applications"))
      dmg = File.join(out, "#{dmg_name}-#{version}-arm64.dmg")
      sh(["hdiutil", "create", "-volname", app_name, "-srcfolder", stage, "-ov", "-format", "UDZO", dmg].shelljoin)
      sh(["codesign", "--sign", "Developer ID Application: #{SIGN_IDENTITY_RELEASE}", "--timestamp", dmg].shelljoin)
      sh([
        "xcrun", "notarytool", "submit", dmg, "--wait",
        "--key", ENV["APPLE_API_KEY"], "--key-id", ENV["APPLE_API_KEY_ID"], "--issuer", ENV["APPLE_API_ISSUER"],
      ].shelljoin)
      sh(["xcrun", "stapler", "staple", dmg].shelljoin)
      assets << dmg
    end

    # Publishing this is the cutover: every Electron desktop that has migrated
    # its secrets follows it, and Squirrel.Mac swaps this app in (same bundle
    # id and team). Stable only, so no Electron user lands on a pre-release.
    if electron_cutover && channel == "production"
      assets << write_electron_feed(File.join(out, "cutover-mac.yml"), zip, version)
    end

    if publish
      tag = "v#{version}"
      ENV["GH_TOKEN"] ||= ENV["GITHUB_TOKEN"]
      prerelease = channel == "production" ? "" : " --prerelease"
      sh("gh release view #{tag} >/dev/null 2>&1 || gh release create #{tag} --title #{tag} --notes ''#{prerelease}")
      sh(["gh", "release", "upload", tag, *assets, "--clobber"].shelljoin)
      UI.success("Published #{app_name} #{version} to #{tag} (#{assets.map { |a| File.basename(a) }.join(", ")})")
    else
      write_release_assets(assets)
      UI.success("Built #{assets.join(", ")}; not published")
    end
  end

  # What a `publish:false` run built, one path per line, for the release workflow
  # to upload once the build has passed and the version is tagged.
  def write_release_assets(paths)
    missing = paths.reject { |p| File.exist?(p) }
    UI.user_error!("Missing release assets: #{missing.join(", ")}") unless missing.empty?
    File.write(File.expand_path("../release-assets.txt", __dir__), paths.join("\n") + "\n")
  end

  # This version's CHANGELOG section as Markdown; CI passes the file it already wrote.
  def release_notes_file
    notes_file = ENV["ARGUS_RELEASE_NOTES_FILE"]
    if notes_file.nil? || notes_file.empty?
      notes_file = File.expand_path("../release-notes.md", __dir__)
      sh("cd .. && pnpm exec tsx scripts/extract-release-notes.ts #{notes_file.shellescape}")
    end
    notes_file
  end

  # An electron-updater manifest for a zip, in the shape electron-builder
  # writes `latest-mac.yml`, so the Electron desktop's "What's new" shows notes.
  def write_electron_feed(path, zip, version)
    notes_file = release_notes_file
    sha512 = Digest::SHA512.file(zip).base64digest
    file = { "url" => File.basename(zip), "sha512" => sha512, "size" => File.size(zip) }
    feed = {
      "version"      => version,
      "files"        => [file],
      "path"         => file["url"],
      "sha512"       => sha512,
      "releaseDate"  => Time.now.utc.iso8601(3),
    }
    feed["releaseNotes"] = File.read(notes_file) if File.exist?(notes_file)
    File.write(path, feed.to_yaml)
    path
  end

  # Build the in-memory `api_key` hash that match / notarize actions
  # accept. Reads the `.p8` body, key id, and issuer id from env vars.
  def load_app_store_connect_api_key
    key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_body  = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_ID")        if key_id.nil? || key_id.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_ISSUER_ID") if issuer_id.nil? || issuer_id.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_CONTENT")   if key_body.nil? || key_body.empty?

    app_store_connect_api_key(
      key_id:      key_id,
      issuer_id:   issuer_id,
      key_content: key_body,
      is_key_content_base64: false,
      in_house:    false,
    )
  end

  # Materialize the App Store Connect API key to disk and expose it to
  # notarytool via APPLE_API_KEY / _KEY_ID / _ISSUER.
  def prepare_notarize_env
    key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_body  = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    key_path = File.expand_path("../.fastlane-api-key.p8", __dir__)
    File.write(key_path, key_body)
    at_exit { File.delete(key_path) if File.exist?(key_path) }

    ENV["APPLE_API_KEY"]    = key_path
    ENV["APPLE_API_KEY_ID"] = key_id
    ENV["APPLE_API_ISSUER"] = issuer_id
  end

  def read_package_version
    pkg_path = File.expand_path("../package.json", __dir__)
    JSON.parse(File.read(pkg_path))["version"]
  end
end

IOS_APP_ID       = "dev.houwert.argus.remote"
IOS_EXTENSION_ID = "dev.houwert.argus.remote.NotificationService"
IOS_WIDGETS_ID   = "dev.houwert.argus.remote.Widgets"
IOS_SHARE_ID     = "dev.houwert.argus.remote.ShareExtension"
IOS_APP_GROUP    = "group.dev.houwert.argus"
# Target name => bundle id, for the App Store profiles each one signs with.
IOS_TARGETS = {
  "ArgusRemote" => IOS_APP_ID, "ArgusNotificationService" => IOS_EXTENSION_ID,
  "ArgusWidgets" => IOS_WIDGETS_ID, "ArgusShare" => IOS_SHARE_ID,
}.freeze

platform :ios do
  desc "One-time, local: create the iPhone app in App Store Connect and the App Store profiles TestFlight builds sign with. Logs in with your Apple ID (App Store Connect API keys can't create apps). Pass name: for the App Store name."
  lane :testflight_setup do |options|
    produce(
      app_identifier: IOS_APP_ID,
      app_name:       options.fetch(:name, "Argus Remote"),
      language:       "en-US",
      sku:            "argus-remote",
      # The app's App ID exists already: development signing registered it.
      skip_devcenter: true,
    )
    # Extensions added later (widgets, share) may not have App IDs yet; all share the app's group.
    IOS_TARGETS.each do |target, bundle_id|
      next if bundle_id == IOS_APP_ID
      produce(app_identifier: bundle_id, app_name: "Argus #{target.delete_prefix('Argus')}",
              skip_itc: true, enable_services: { app_group: "on" })
      # fastlane has no action for this; `produce` above left Produce.config on this bundle id.
      require "produce/group"
      Produce::Group.new.associate(nil, [IOS_APP_GROUP])
    end
    # The Matchfile skips profiles for the Mac's Developer ID cert; every iPhone target needs one.
    match(type: "appstore", platform: "ios", app_identifier: IOS_TARGETS.values, readonly: false,
          skip_provisioning_profiles: false)
  end

  desc "Build the iPhone app and upload it to TestFlight. The Release workflow runs it in parallel with the Mac build, so both share a version and build number. Needs the profiles from testflight_setup."
  lane :testflight do
    api_key = load_app_store_connect_api_key
    match(type: "appstore", platform: "ios", app_identifier: IOS_TARGETS.values, readonly: true, api_key: api_key,
          skip_provisioning_profiles: false)

    root = File.expand_path("..", __dir__)
    out = File.join(root, "release-ios")
    FileUtils.rm_rf(out)
    project = File.join(root, "clients/apple/ArgusRemote.xcodeproj")
    # App Store versions are plain x.y.z, so a beta or alpha cut drops its suffix; the build number still tells them apart.
    version = read_package_version.sub(/-.*\z/, "")
    build_number = ci_build_number

    # Development builds sign automatically; App Store builds sign with match's profiles.
    IOS_TARGETS.each do |target, bundle_id|
      update_code_signing_settings(
        path:                  project,
        targets:               [target],
        build_configurations:  ["Release"],
        use_automatic_signing: false,
        team_id:               TEAM_ID,
        code_sign_identity:    "Apple Distribution",
        profile_name:          "match AppStore #{bundle_id}",
      )
    end

    packages = ENV["SPM_CLONE_DIR"].to_s.empty? ? File.join(out, "SourcePackages") : ENV["SPM_CLONE_DIR"]
    ipa = build_app(
      project:                      project,
      scheme:                       "ArgusRemote",
      configuration:                "Release",
      export_method:                "app-store",
      export_options:               { provisioningProfiles: IOS_TARGETS.values.to_h { |id| [id, "match AppStore #{id}"] } },
      output_directory:             out,
      cloned_source_packages_path:  packages,
      # System git, so the url.insteadOf CI sets reaches private packages (Grove).
      xcargs:                       "-scmProvider system MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
    )

    upload_to_testflight(
      api_key:                           api_key,
      # The Appfile's app_identifier is the Mac app's.
      app_identifier:                    IOS_APP_ID,
      ipa:                               ipa,
      changelog:                         File.read(release_notes_file)[0, 4000],
      skip_waiting_for_build_processing: true,
    )
    UI.success("Uploaded Argus #{version} (#{build_number}) to TestFlight")
  end
end
