default_platform(:mac)

TEAM_ID      = "CKZT75PN5T"
# electron-builder reads CSC_NAME and adds the type prefix internally — it
# rejects values that already start with "Apple Development:" or
# "Developer ID Application:", so we pass the bare common name.
SIGN_IDENTITY_DEV     = "Douwe Bos (#{TEAM_ID})"
SIGN_IDENTITY_RELEASE = "Douwe Bos (#{TEAM_ID})"

platform :mac do
  desc "Sync the Developer ID Application cert from the match repo. Pass generate:true on first run to create and upload a new cert."
  lane :certs do |options|
    # In CI we always authenticate via API key (non-interactive).
    # Locally, fall back to interactive Apple ID + 2FA when the API
    # key env vars are not set — saves the "set up a key just to try
    # it once" friction.
    api_key = ENV["APP_STORE_CONNECT_API_KEY_ID"] ? load_app_store_connect_api_key : nil
    UI.user_error!("CI must authenticate via APP_STORE_CONNECT_API_KEY_* env vars") if is_ci && api_key.nil?

    match_options = {
      type:                       "developer_id",
      readonly:                   !options.fetch(:generate, false),
      platform:                   "macos",
      # Argus uses no entitlements that require a provisioning profile.
      # Without this flag, recent fastlane tries to fetch a "Direct"
      # provisioning profile and fails for Developer ID distribution.
      skip_provisioning_profiles: true,
    }
    match_options[:api_key] = api_key if api_key

    match(**match_options)
  end

  desc "Local dev build. Apple Development cert, no notarization."
  lane :dev do
    sh("cd .. && pnpm install --frozen-lockfile")
    ENV["CSC_NAME"] = SIGN_IDENTITY_DEV
    sh("cd .. && pnpm build && pnpm exec electron-builder")
    UI.success("Built release/mac-arm64/Argus.app")
  end

  desc "Release build: signed with Developer ID, notarized, stapled, uploaded to a GitHub release. Pass channel:alpha or channel:rc to publish a pre-release from any branch."
  lane :release do |options|
    publish = options.fetch(:publish, true)
    channel = options.fetch(:channel, "stable")
    unless ["stable", "alpha", "rc"].include?(channel)
      UI.user_error!("Unknown channel #{channel.inspect} — expected stable | alpha | rc")
    end

    ensure_git_status_clean unless options[:allow_dirty]
    # Stable cuts must come from main; pre-release builds can come from any
    # branch (CI passes allow_any_branch:true unconditionally; this guard is
    # for local invocations).
    if channel == "stable"
      ensure_git_branch(branch: "main") unless options[:allow_any_branch]
    end

    api_key = load_app_store_connect_api_key
    match(
      type:                       "developer_id",
      readonly:                   true,
      api_key:                    api_key,
      platform:                   "macos",
      skip_provisioning_profiles: true,
    )

    # Version + tag are driven by changesets. CI runs `changeset version`,
    # commits, and pushes the tag before invoking this lane. Locally: run
    # `pnpm exec changeset version`, commit, tag, and push before `dist:release`.
    version = read_package_version
    UI.success("Releasing v#{version}")

    prepare_notarize_env

    ENV["CSC_NAME"]        = SIGN_IDENTITY_RELEASE
    # Let electron-builder find the Developer ID cert match just installed
    # into build.keychain. With auto-discovery off electron-builder ignores
    # the keychain entirely (it expects CSC_LINK/CSC_KEY_PASSWORD instead),
    # which is why CI was falling back to ad-hoc signing.
    ENV["CSC_IDENTITY_AUTO_DISCOVERY"] = "true"
    ENV["CSC_KEYCHAIN"]    = ENV["MATCH_KEYCHAIN_NAME"] if ENV["MATCH_KEYCHAIN_NAME"] && !ENV["MATCH_KEYCHAIN_NAME"].empty?
    ENV["GH_TOKEN"]        = ENV["GITHUB_TOKEN"] if ENV["GITHUB_TOKEN"] && ENV["GH_TOKEN"].nil?

    sh("cd .. && pnpm install --frozen-lockfile")

    # Generate release-notes.md from the current version's CHANGELOG.md
    # section unless the caller already provided a file. electron-builder
    # embeds this into latest-mac.yml so electron-updater can show it
    # inside the running app's "What's new" dialog.
    notes_file = ENV["ARGUS_RELEASE_NOTES_FILE"]
    if notes_file.nil? || notes_file.empty?
      notes_file = File.expand_path("../release-notes.md", __dir__)
      sh("cd .. && pnpm exec tsx scripts/extract-release-notes.ts #{notes_file.shellescape}")
    end

    notes_flag = ""
    if File.exist?(notes_file)
      notes_flag = " --config.releaseInfo.releaseNotesFile=#{notes_file.shellescape}"
    end

    # Channel routing for electron-builder + electron-updater:
    #   stable → latest-mac.yml,  releaseType=release
    #   alpha  → alpha-mac.yml,   releaseType=prerelease
    #   rc     → beta-mac.yml,    releaseType=prerelease
    # electron-builder reads EP_CHANNEL and EP_PRE_RELEASE env vars.
    if channel == "alpha"
      ENV["EP_CHANNEL"]      = "alpha"
      ENV["EP_PRE_RELEASE"]  = "true"
    elsif channel == "rc"
      ENV["EP_CHANNEL"]      = "beta"
      ENV["EP_PRE_RELEASE"]  = "true"
    else
      ENV["EP_CHANNEL"]      = "latest"
      ENV["EP_PRE_RELEASE"]  = "false"
    end

    publish_flag = publish ? "--publish always" : "--publish never"
    sh("cd .. && pnpm build && pnpm exec electron-builder --config electron-builder.release.yml #{publish_flag}#{notes_flag}")

    # Package and upload the plugin assets to the same release tag. The
    # renderer's asset resolver fetches them on first plugin enable. Skipped
    # locally when the user passes publish:false — there's no GH release to
    # upload to in that case.
    if publish
      sh("cd .. && pnpm exec tsx scripts/release-plugins.ts")
    end

    # Stable-only side effects: the website-changelog dispatch and main-branch
    # commit/tag bump are driven from the workflow, not this lane. Pre-release
    # builds skip those upstream.
  end

  # ---------------------------------------------------------------
  # Helpers
  # ---------------------------------------------------------------

  # Build the in-memory `api_key` hash that match / notarize actions
  # accept. Reads the `.p8` body, key id, and issuer id from env vars.
  def load_app_store_connect_api_key
    key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_body  = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_ID")        if key_id.nil? || key_id.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_ISSUER_ID") if issuer_id.nil? || issuer_id.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_CONTENT")   if key_body.nil? || key_body.empty?

    app_store_connect_api_key(
      key_id:      key_id,
      issuer_id:   issuer_id,
      key_content: key_body,
      is_key_content_base64: false,
      in_house:    false,
    )
  end

  # Materialize the App Store Connect API key to disk and expose it to
  # electron-builder via APPLE_API_KEY / _KEY_ID / _ISSUER. Called from
  # the release lane right before invoking electron-builder.
  def prepare_notarize_env
    key_id    = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_body  = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]

    key_path = File.expand_path("../.fastlane-api-key.p8", __dir__)
    File.write(key_path, key_body)
    at_exit { File.delete(key_path) if File.exist?(key_path) }

    ENV["APPLE_API_KEY"]    = key_path
    ENV["APPLE_API_KEY_ID"] = key_id
    ENV["APPLE_API_ISSUER"] = issuer_id
  end

  def read_package_version
    pkg_path = File.expand_path("../package.json", __dir__)
    JSON.parse(File.read(pkg_path))["version"]
  end
end
