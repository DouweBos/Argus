{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'o=$(pnpm lint 2>&1) || { printf \"%s\\n\" \"$o\" >&2; exit 2; }'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'o=$(pnpm lint 2>&1) || { printf \"%s\\n\" \"$o\" >&2; exit 2; }'"
          }
        ]
      }
    ]
  }
}
