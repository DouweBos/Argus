{
  "expo": {
    "name": "Argus Remote",
    "slug": "argus-remote",
    "version": "0.1.0",
    "scheme": "argus-remote",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.houwert.argus.remote",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR code shown in Argus."
      }
    },
    "android": {
      "package": "dev.houwert.argus.remote",
      "permissions": ["CAMERA", "USE_BIOMETRIC"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        { "cameraPermission": "Scan the pairing QR code shown in Argus." }
      ]
    ]
  }
}
