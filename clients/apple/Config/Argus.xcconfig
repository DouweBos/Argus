// Build settings the app reads at runtime through Info.plist, and that the Mac
// app's host build phase passes on to the Node host (`build-host.mjs`).

// Empty by default: no key means telemetry stays off entirely.
POSTHOG_KEY =
// Spelled through `SLASH` because xcconfig reads a literal `//` as a comment.
SLASH = /
POSTHOG_HOST = https:$(SLASH)$(SLASH)eu.i.posthog.com

// Sparkle's EdDSA public key (`generate_keys`). Empty: the Mac app and Argus
// Server never check for updates, since they couldn't verify one.
SPARKLE_PUBLIC_ED_KEY =

// The maintainer's Apple team. Building yourself? Set your own in
// `Argus.local.xcconfig` (below) instead of editing the project.
DEVELOPMENT_TEAM = CKZT75PN5T

// A gitignored `Argus.local.xcconfig` beside this file wins — included last so
// its values override the defaults above — so a contributor can use their own
// team or PostHog project without touching git.
#include? "Argus.local.xcconfig"
