// Build settings the app reads at runtime through Info.plist.
//
// A gitignored `Argus.local.xcconfig` beside this file wins, so a contributor
// can point their own PostHog project at a local build without touching git.
#include? "Argus.local.xcconfig"

// Empty by default: no key means telemetry stays off entirely.
POSTHOG_KEY =
// Spelled through `SLASH` because xcconfig reads a literal `//` as a comment.
SLASH = /
POSTHOG_HOST = https:$(SLASH)$(SLASH)eu.i.posthog.com
