{
  "name": "argus-web",
  "version": "0.1.25",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:hosted": "tsc --noEmit && vite build --config vite.hosted.config.ts",
    "dev:hosted": "vite --config vite.hosted.config.ts"
  },
  "dependencies": {
    "@argus/client-core": "workspace:*",
    "@argus/peacock": "workspace:*",
    "@argus/remote-client": "workspace:*",
    "@argus/remote-protocol": "workspace:*",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.8"
  },
  "license": "MIT",
  "author": "Douwe Bos <douwe@douwebos.nl> (https://houwert.dev)"
}
