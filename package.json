{
  "name": "argus",
  "description": "Agentic IDE for mobile development",
  "author": "Houwert",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DouweBos/Argus.git"
  },
  "homepage": "https://github.com/DouweBos/Argus",
  "bugs": "https://github.com/DouweBos/Argus/issues",
  "version": "0.59.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-dev}\" pnpm ensure:bridge && ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-dev}\" ARGUS_REMOTE_PORT=\"${ARGUS_REMOTE_PORT:-47616}\" concurrently -n vite,electron \"vite\" \"pnpm build:electron && electron .\"",
    "dev:prod-state": "concurrently -n vite,electron \"vite\" \"pnpm build:electron && electron .\"",
    "ensure:bridge": "pnpm build:bridge || (test -x native/argus-sim-bridge/argus-sim-bridge && test -x native/argus-sim-input/argus-sim-input)",
    "dev:vite": "vite",
    "dev:electron": "ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-dev}\" pnpm build:electron && ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-dev}\" electron .",
    "dev:server": "ARGUS_SERVER=1 ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-server-dev}\" ARGUS_REMOTE_PORT=\"${ARGUS_REMOTE_PORT:-47617}\" pnpm build:electron && ARGUS_SERVER=1 ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-server-dev}\" ARGUS_REMOTE_PORT=\"${ARGUS_REMOTE_PORT:-47617}\" electron dist-electron/server.js",
    "build:electron": "node build-electron.mjs",
    "build:web-client": "pnpm --filter argus-web build",
    "hotswap": "tsx scripts/hotswap-app.ts",
    "hotswap:web-client": "tsx scripts/hotswap-web-client.ts",
    "build": "pnpm ensure:bridge && tsc --noEmit && pnpm typecheck:electron && vite build && pnpm build:electron",
    "build:app": "pnpm build && pnpm build:web-client && electron-builder",
    "build:app:server": "pnpm build && pnpm build:web-client && electron-builder --config scripts/electron-builder-server.config.cjs",
    "dist:dev": "bundle exec fastlane mac dev",
    "dist:release": "bundle exec fastlane mac release",
    "certs": "bundle exec fastlane mac certs",
    "preview": "vite preview",
    "storybook": "pnpm --filter @argus/peacock storybook",
    "lint": "tsc --noEmit && pnpm typecheck:electron && pnpm typecheck:host && eslint . && prettier --check . && pnpm run lint:css-modules && pnpm run lint:cycles",
    "build:bridge": "make -C native/argus-sim-bridge && make -C native/argus-sim-input",
    "build:icon": "tsx scripts/generate-icon.ts",
    "build:menu-icons": "tsx scripts/rasterize-menu-icons.ts",
    "server:install-agent": "bash scripts/install-server-agent.sh",
    "lint:css-modules": "tsx scripts/check-css-module-usage.ts",
    "lint:cycles": "tsx scripts/check-import-cycles.ts",
    "lint:ts": "pnpm typecheck:app && pnpm typecheck:electron && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:app": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:host": "tsc -p packages/host/tsconfig.json --noEmit",
    "postinstall": "tsx scripts/fix-node-pty-helper.ts && tsx scripts/fetch-scrcpy-server.ts && tsx scripts/prepare-conductor.ts",
    "shots": "tsx scripts/shots.ts"
  },
  "dependencies": {
    "@argus/host": "workspace:*",
    "@argus/peacock": "workspace:*",
    "@argus/remote-client": "workspace:*",
    "@argus/remote-protocol": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/dompurify": "^3.2.0",
    "@types/hast": "^3.0.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.0",
    "dompurify": "^3.4.0",
    "electron-updater": "^6.3.0",
    "fast-glob": "^3.3.0",
    "fast-xml-parser": "^5.7.2",
    "marked": "^17.0.4",
    "mermaid": "^11.16.0",
    "node-pty": "^1.0.0",
    "posthog-node": "^5.30.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@electron/asar": "^4.3.0",
    "@eslint/js": "^9.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.15",
    "concurrently": "^9.0.0",
    "confusing-browser-globals": "^1.0.11",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "0.27.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-css-modules-next": "^1.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller",
      "node-pty"
    ]
  }
}
