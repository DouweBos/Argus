{
  "name": "argus",
  "description": "Agentic IDE for front-end development",
  "author": "Douwe Bos <douwe@douwebos.nl> (https://houwert.dev)",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DouweBos/Argus.git"
  },
  "homepage": "https://github.com/DouweBos/Argus",
  "bugs": "https://github.com/DouweBos/Argus/issues",
  "version": "0.73.0",
  "type": "module",
  "scripts": {
    "ensure:bridge": "pnpm build:bridge || (test -x native/argus-sim-bridge/argus-sim-bridge && test -x native/argus-sim-input/argus-sim-input)",
    "build:host": "node build-host.mjs",
    "build:mac-host": "tsx scripts/build-mac-host.ts",
    "dev:host": "ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-host-dev}\" ARGUS_REMOTE_PORT=\"${ARGUS_REMOTE_PORT:-47618}\" pnpm build:host && ARGUS_HOME=\"${ARGUS_HOME:-$HOME/.argus-host-dev}\" ARGUS_REMOTE_PORT=\"${ARGUS_REMOTE_PORT:-47618}\" node --enable-source-maps dist-host/argus-host.js",
    "start:host": "node --enable-source-maps dist-host/argus-host.js",
    "build:web-client": "pnpm --filter argus-web build",
    "build:web-client:hosted": "pnpm --filter argus-web build:hosted",
    "hotswap:web-client": "tsx scripts/hotswap-web-client.ts",
    "build": "pnpm ensure:bridge && pnpm typecheck && pnpm build:host && pnpm build:web-client",
    "dist:release": "bundle exec fastlane mac mac_app_release",
    "certs": "bundle exec fastlane mac certs",
    "storybook": "pnpm --filter @argus/peacock storybook",
    "lint": "pnpm typecheck && eslint . && prettier --check . && pnpm run lint:css-modules && pnpm run lint:cycles && pnpm run lint:swift && pnpm gen:protocol --check",
    "build:bridge": "make -C native/argus-sim-bridge && make -C native/argus-sim-input",
    "build:icon": "swift scripts/render-icon.swift",
    "lint:css-modules": "tsx scripts/check-css-module-usage.ts",
    "lint:cycles": "tsx scripts/check-import-cycles.ts",
    "lint:swift": "tsx scripts/check-swift-styles.ts",
    "gen:file-icons": "tsx scripts/gen-file-icons.ts",
    "gen:protocol": "tsx scripts/gen-protocol.ts",
    "lint:ts": "pnpm typecheck && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:host": "tsc -p packages/host/tsconfig.json --noEmit",
    "postinstall": "tsx scripts/fix-node-pty-helper.ts && tsx scripts/fetch-scrcpy-server.ts && tsx scripts/prepare-conductor.ts",
    "shots": "tsx scripts/shots.ts",
    "gen:account-fixtures": "tsx scripts/gen-account-fixtures.ts",
    "typecheck": "pnpm typecheck:host && pnpm -r --filter=!@argus/host --filter=!@argus/remote-protocol typecheck"
  },
  "dependencies": {
    "@argus/host": "workspace:*",
    "@argus/remote-protocol": "workspace:*",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "chokidar": "^4.0.0",
    "fast-glob": "^3.3.0",
    "fast-xml-parser": "^5.12.0",
    "marked": "^17.0.4",
    "node-pty": "^1.0.0",
    "posthog-node": "^5.30.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "confusing-browser-globals": "^1.0.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
